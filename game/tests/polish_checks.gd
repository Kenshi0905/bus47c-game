extends RefCounted
const Scenarios=preload("res://tests/scenario_checks.gd")
static func run(g) -> bool:
	var a=g.aftermath
	g.start_game(10)
	a.restore({"phase":"town","branch":"bus"})
	var id: String=a.town_horror.resident_spots[0]
	var spot: Dictionary=a.spots[id]
	Scenarios.aim(g,id,spot.parent.to_global(Vector3(0,.15,.5)))
	assert(g.prompt.text=="E   Inspect")
	assert(a.town_horror.bodies.find_children("*","Label3D",true,false).is_empty(),"Corpses must not reveal names")
	g.request_interaction(id)
	assert("Oh God" in g.subtitle.text and id in a.town_horror.inspected)
	a.restore({"phase":"fork","branch":"walk","parts":[0,1,2,3,4]})
	g.request_interaction("repair_engine")
	a.update(2)
	assert(a.presentation.panel.visible and a.presentation.progress.value>.3)
	var time: float=a.state_time
	g.show_menu(true)
	g._process(30)
	assert(a.state_time==time)
	g.resume_game()
	assert(not g.player.enabled)
	a.update(3.1)
	a.update(0)
	assert(a.repairs.repaired and not a.presentation.panel.visible)
	a.restore({"phase":"burial","branch":"bus"})
	a.shovel=true
	a.lay_body(a.HOUSE+Vector3(2.2,.18,-9))
	g.request_interaction("grave")
	a.update(3)
	assert(a.presentation.panel.visible and "soil" not in a.presentation.action_step.text)
	a.update(5.1)
	a.update(0)
	assert(a.phase=="closet_ready" and not a.presentation.panel.visible)
	g.request_interaction("closet")
	assert(g.player.enabled and g.player.confined)
	a.update(1)
	assert("1:29" in a.status.text)
	var yaw: float=g.player.rotation.y
	var mouse := InputEventMouseMotion.new()
	mouse.relative=Vector2(80,10)
	g.player._unhandled_input(mouse)
	if DisplayServer.get_name()!="headless":
		assert(g.player.rotation.y!=yaw,"Hidden player must still look around")
	var origin: Vector3=g.player.global_position
	Input.action_press("right")
	await g.get_tree().create_timer(.8).timeout
	Input.action_release("right")
	assert(g.player.global_position.distance_to(origin)>.04,"Hidden player can shift position")
	assert(g.player.hiding_bounds.grow(.02).has_point(g.player.global_position),"Movement stays inside the wardrobe")
	Input.action_press("zoom")
	a.update(1)
	assert(absf(a.wardrobe_doors[0].rotation.y)>.1,"RMB opens a peeking gap")
	Input.action_release("zoom")
	g.show_document("journal")
	time=a.state_time
	g._process(20)
	assert(a.state_time==time)
	g.close_document()
	assert(g.player.enabled and g.player.confined)
	g.show_menu(true)
	g._process(20)
	g.resume_game()
	assert(g.player.enabled and g.player.confined)
	a.update(1)
	assert(absf(a.wardrobe_doors[0].rotation.y)<.01)
	a.update(90)
	assert(a.phase=="dawn" and not g.player.confined)
	g.request_interaction("coffee")
	a.update(2)
	assert(a.phase=="brewing" and a.presentation.panel.visible and not a.coffee)
	g.request_interaction("newspaper")
	assert(not g.modal,"Paper is available after the coffee action finishes")
	a.update(2.1)
	g.request_interaction("newspaper")
	await g.get_tree().process_frame
	assert(g.modal and g.modal_kind=="newspaper")
	assert(g.modal_box.find_children("*","TextureRect",true,false).size()==2)
	for picture in g.modal_box.find_children("*","TextureRect",true,false):
		assert(picture.get_parent().get_global_rect().encloses(picture.get_global_rect()),"Press photos must stay inside the paper columns")
	assert(g.modal_panel.get_global_rect().end.y<710,"Newspaper must fit the screen")
	g.close_document()
	assert(a.phase=="epilogue" and not g.paused and not g.player.enabled)
	a.update(7)
	assert(a.phase=="epilogue" and not a.presentation.credit_card.visible)
	g.show_menu(true)
	time=a.state_time
	g._process(60)
	g.resume_game()
	assert(a.state_time==time and not g.player.enabled)
	a.update(15)
	assert(a.presentation.credit_card.is_visible_in_tree() and not g.menu.visible)
	a.update(12)
	assert(a.phase=="ending" and g.paused and g.get_viewport().gui_get_focus_owner() is Button)
	g.return_to_title()
	assert(not a.presentation.credit_card.visible and not g.player.confined)
	# Abandoned routes are labelled, not crossed off as completed tasks.
	a.restore({"phase":"town","branch":"walk"})
	var notes: String=preload("res://scripts/shift_journal.gd").content(g)
	assert("Bus repair left behind" in notes and "[s]Collect engine" not in notes)
	g.return_to_title()
	print("PASS: unknown residents inspected, real action progress, bounded closet movement and peeking, pause-safe countdown, illustrated newspaper and complete ending with credits")
	return true
