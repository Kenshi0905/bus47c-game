extends SceneTree
const Story = preload("res://scripts/story.gd")
func _initialize() -> void:
	var s = Story.new()
	assert(not s.interact("door"), "Cannot board before reading note")
	assert(s.interact("note"))
	assert(not s.interact("note"), "Repeated interaction must not skip stage")
	assert(not s.tick(11.9))
	assert(s.tick(0.2))
	assert(s.interact("door"))
	assert(s.checkpoint() == Story.Stage.CAB)
	assert(s.interact("driver"))
	assert(s.interact("clock"))
	assert(not s.tick(Story.DURATIONS[Story.Stage.RIDING]-1))
	assert(s.tick(1.1))
	assert(s.depart_stop(), "First passenger must not require looking back")
	assert(not s.interact("passenger"))
	assert(s.tick(Story.DURATIONS[Story.Stage.NEXT_RIDE]+.1))
	assert(not s.interact("route"))
	assert(s.depart_stop())
	assert(not s.depart_stop())
	assert(s.tick(Story.DURATIONS[s.stage]+.1))
	assert(s.stage==Story.Stage.THIRD_STOP and s.stop_index()==3)
	assert(s.depart_stop())
	assert(s.tick(Story.DURATIONS[s.stage]+.1))
	assert(s.stage==Story.Stage.FOURTH_STOP and s.stop_index()==4)
	assert(s.depart_stop())
	assert(not s.tick(Story.DURATIONS[Story.Stage.FINAL_RIDE]-5.1))
	assert(s.stage==Story.Stage.FINAL_RIDE and s.leg_index()==4)
	assert(s.tick(5.2))
	assert(s.interact("deer"))
	assert(s.stage==Story.Stage.FINISHED)
	for bad in [-8, 900, "corrupt", {}, null]:
		s.restore(bad)
		assert(s.stage == Story.Stage.STOP)
	for valid in [0, 2, 3, 6, 8, 10, 13, 15]:
		s.restore(valid)
		assert(s.stage == valid)
	assert(Story.STOP_NAMES.size()==6 and Story.STOP_Z.size()==6)
	print("PASS: six-stop route, deer only on final leg, idempotency and checkpoint validation")
	quit()
