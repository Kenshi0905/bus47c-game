extends RefCounted
static func run(g) -> void:
	g.start_game(0)
	g._process(.25)
	g.paused=true
	await g.capture_frame("firewatcher-intro")
	var a=g.aftermath
	a.restore({"phase":"town","branch":"bus"})
	a.place_player(a.HOUSE+Vector3(0,.15,2.5),a.HOUSE+Vector3(0,1.3,-1))
	await g.capture_frame("suited-house-attacker")
	a.restore({"phase":"burial","branch":"bus"})
	a.place_player(a.HOUSE+Vector3(.6,.15,1.6),a.body_center())
	await g.capture_frame("grounded-suited-body")
	a.restore({"phase":"closet","branch":"bus"})
	a.interact("closet")
	a.update(90.1)
	a.update(0)
	await g.capture_frame("wardrobe-daylight-exit")
	a.restore({"phase":"closet","branch":"bus"})
	a.interact("closet")
	a.interact("leave_closet")
	a.update(2.4)
	await g.capture_frame("wardrobe-dragged-out")
	a.update(5.2)
	await g.capture_frame("wardrobe-hounds")
	a.update(4)
	await g.capture_frame("attack-retry")
	g.continue_game()
	g.paused=true
	a.restore({"phase":"town","branch":"walk"})
	a.place_player(Vector3(111,.15,-815),Vector3(105,1,-820))
	a.update(1.3)
	a.update(6.6)
	await g.capture_frame("forest-hounds")
	a.restore({"phase":"escape","branch":"walk"})
	a.place_player(a.events.PATH[-1]+Vector3(0,.15,0),a.events.PATH[-1]+Vector3(0,1,-2))
	a.events.start_fall("forestry_fall")
	a.update(4.1)
	await g.capture_frame("grounded-tie-reveal")
	a.restore({"phase":"town","branch":"bus"})
	a.place_player(Vector3(124,.15,-738),Vector3(122,.1,-740))
	await g.capture_frame("red-blood-pools")
	g.quit_cleanly()
