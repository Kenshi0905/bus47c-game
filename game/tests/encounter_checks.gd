extends RefCounted
const Scenarios=preload("res://tests/scenario_checks.gd")
static func run(g) -> bool:
	g.start_game(0)
	assert("firewatcher" in g.subtitle.text)
	var a=g.aftermath
	a.restore({"phase":"burial","branch":"bus"})
	assert(a.intruder_model.visible and a.intruder_model.find_child("red_tie*",true,false)!=null)
	a.shovel=true
	a.place_player(a.HOUSE+Vector3(0,.15,1.6),a.body_center())
	g.request_interaction("body")
	var before: Vector3=a.body_center()
	g.player.rotate_y(PI)
	a.update(.4)
	assert(a.body_center().distance_to(before)<.01,"Looking around must not orbit the corpse")
	await Scenarios.walk_to(g,a.HOUSE+Vector3(1.3,.15,1.6))
	await Scenarios.walk_to(g,a.HOUSE+Vector3(1.3,.15,-3))
	await Scenarios.walk_to(g,a.HOUSE+Vector3(0,.15,-4.7))
	await Scenarios.walk_to(g,a.HOUSE+Vector3(0,.15,-6.8))
	await Scenarios.walk_to(g,a.HOUSE+Vector3(2.2,.15,-9.7))
	assert(a.dragging and a.grave_ready(),"Body must physically pass furniture and back doorway: %s dragging %s" % [a.body_center(),a.dragging])
	assert(a.body_center().y>.1 and a.body_center().y<.5)
	g.request_interaction("body")
	before=a.body_center()
	a.update(1)
	assert(a.body_center().distance_to(before)<.01,"Dropped body stays put")
	# Test the collision sweep independently against a house wall.
	a.lay_body(a.HOUSE+Vector3(3.7,.36,0))
	a.place_player(a.HOUSE+Vector3(4.5,.15,0),a.HOUSE+Vector3(5,1,0))
	a.interact("body")
	a.corpse_physics.trail.assign([a.HOUSE+Vector3(7,.15,0)])
	for i in range(60):a.corpse_physics.update_drag(.016)
	assert(a.body_center().x<a.HOUSE.x+4.95,"Corpse must not pass through the outer wall")
	a.restore({"phase":"closet","branch":"bus"})
	a.interact("closet")
	a.update(90.1)
	assert(a.phase=="closet" and a.encounters.daylight_ready and g.player.confined)
	before=g.player.global_position
	a.interact("leave_closet")
	assert(a.phase=="closet_exit" and not g.player.enabled)
	a.update(.9)
	assert(g.player.global_position.z>before.z and g.player.global_position.z<a.HOUSE.z-1.5)
	a.update(1)
	assert(a.phase=="dawn" and g.player.enabled and not g.player.confined)
	for kind in ["closet_attack","forest_hounds"]:
		g.start_game(10)
		a.restore({"phase":"closet","branch":"bus"} if kind=="closet_attack" else {"phase":"town","branch":"walk"})
		if kind=="closet_attack":
			a.interact("closet")
			a.interact("leave_closet")
		else:
			# The mart and all town interiors stay safe, even before the mirror.
			a.place_player(Vector3(144,.15,-753),Vector3(140,1,-753))
			a.update(3)
			assert(a.phase=="town")
			a.place_player(Vector3(111,.15,-815),Vector3(106,1,-820))
			a.update(1.3)
		assert(a.phase==kind and not g.player.enabled and not g.paused)
		a.update(4.5)
		assert(a.encounters.overlay.visible and a.encounters.head.visible)
		assert(a.encounters.material.get_shader_parameter("amount")>.1)
		var clock: float=a.state_time
		g.show_menu(true)
		g._process(20)
		assert(a.state_time==clock)
		g.resume_game()
		assert(not g.player.enabled)
		a.update(7)
		assert(a.phase=="dead" and not a.encounters.overlay.visible and not a.encounters.actors.visible)
		assert(g.get_viewport().gui_get_focus_owner().text=="TRY AGAIN")
		g.continue_game()
		assert(g.player.enabled and not a.encounters.overlay.visible and is_zero_approx(g.player.camera.rotation.z))
	a.restore({"phase":"escape","branch":"walk"})
	a.place_player(Vector3(111,.15,-815),Vector3(105,1,-820))
	a.update(2)
	assert(a.phase=="escape","Mirror-complete route must never trigger wolves")
	a.events.start_fall("forestry_fall")
	before=a.events.own_body.global_position
	a.update(4)
	assert(a.events.own_body.get_parent()==a.events,"Fallen body belongs to world, not camera")
	assert(a.events.own_body.global_position==before and a.events.own_body.scale==Vector3.ONE)
	assert(a.events.own_body.global_position.y>.15 and a.events.own_body.global_position.y<.8)
	for mesh in a.events.own_body.find_children("*","MeshInstance3D",true,false):
		if mesh.material_override is StandardMaterial3D:assert(not mesh.material_override.no_depth_test)
	a.update(9.1)
	a.update(3.1)
	assert(a.phase=="loop" and g.player.enabled)
	var blood: StandardMaterial3D=preload("res://scripts/blood_palette.gd").material()
	assert(blood.albedo_color.r>blood.albedo_color.g*4 and blood.emission_energy_multiplier>.15)
	g.return_to_title()
	print("PASS: collision-aware grounded drag, suited attacker, physical manual closet exit, staged early-exit and forest deaths, town safety, pause and retry, grounded body reveal and red blood")
	return true
